---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	currentPath?: string;
}

const {
	title = 'NutriGuide',
	description = 'Trouvez des aliments, recettes et reperes nutritionnels adaptes a vos objectifs.',
	currentPath = '/',
} = Astro.props;

const navItems = [
	{ href: '/regimes', label: 'Regimes', active: currentPath === '/regimes' },
	{ href: '/aliments', label: 'Aliments', active: currentPath.startsWith('/aliments') },
	{ href: '/recettes', label: 'Recettes', active: currentPath.startsWith('/recettes') },
	{ href: '/conseils', label: 'Conseils', active: currentPath.startsWith('/conseils') },
	{ href: '/calculateur', label: 'Calculateur', active: currentPath.startsWith('/calculateur') },
];
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-[#f7f3ec] text-[#243428] antialiased [font-family:'Avenir_Next','Segoe_UI',sans-serif]">
		<div class="min-h-screen pb-10">
			<header class="mx-auto max-w-[1240px] px-4 py-5 sm:px-6">
				<div class="flex items-center justify-between gap-4">
					<a class="flex items-center gap-3" href="/">
						<img
							src="/logo-nutriguide.svg"
							alt="NutriGuide"
							class="h-11 w-11 shrink-0"
							loading="eager"
						/>
						<div class="flex flex-col">
							<span class="text-[16px] font-semibold tracking-[-0.02em] text-[#314033]">NutriGuide</span>
							<span class="text-xs text-[#7d8478]">Nutrition claire, recettes utiles</span>
						</div>
					</a>

					<nav class="hidden flex-wrap items-center gap-x-6 gap-y-2 text-[14px] text-[#727a70] lg:flex">
						{navItems.map((item) => (
							<a
								href={item.href}
								class:list={[
									'transition hover:text-[#4f7557]',
									item.active ? 'font-semibold text-[#4f7557]' : '',
								]}
							>
								{item.label}
							</a>
						))}
					</nav>

					<div class="hidden items-center gap-3 lg:flex">
						<a
							data-admin-nav-link
							class="hidden rounded-full border border-[#d9ddcf] bg-[#eef2eb] px-4 py-2 text-sm font-medium text-[#4f7557] transition hover:border-[#c8d3c4] hover:bg-[#e7efe4]"
							href="/admin"
						>
							Backoffice
						</a>
						<a
							data-auth-link
							class="rounded-full border border-[#dddcd2] bg-white/80 px-4 py-2 text-sm font-medium text-[#5e675d] transition hover:border-[#c8d3c4] hover:text-[#4f7557]"
							href="/connexion"
						>
							Connexion
						</a>
						<a
							class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-[#dddcd2] bg-white/80 text-[#5e675d] transition hover:border-[#c8d3c4] hover:text-[#4f7557]"
							href="/recherche"
							aria-label="Voir les recettes"
						>
							<svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<circle cx="11" cy="11" r="6.5"></circle>
								<path d="M16 16L21 21"></path>
							</svg>
						</a>
					</div>

					<button
						id="mobile-menu-button"
						type="button"
						class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-[#dddcd2] bg-white/80 text-[#5e675d] transition hover:border-[#c8d3c4] hover:text-[#4f7557] lg:hidden"
						aria-expanded="false"
						aria-controls="mobile-menu"
						aria-label="Ouvrir le menu"
					>
						<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
							<path d="M4 7h16"></path>
							<path d="M4 12h16"></path>
							<path d="M4 17h16"></path>
						</svg>
					</button>
				</div>

				<div
					id="mobile-menu"
					class="hidden rounded-[20px] border border-[#e4ddcf] bg-white/95 p-4 shadow-[0_18px_36px_rgba(76,82,58,0.06)] lg:hidden"
				>
					<nav class="grid gap-2 text-[15px] text-[#5e675d]">
						{navItems.map((item) => (
							<a
								href={item.href}
								class:list={[
									'rounded-[12px] px-3 py-3 transition hover:bg-[#f4f7f1] hover:text-[#4f7557]',
									item.active ? 'bg-[#f4f7f1] font-semibold text-[#4f7557]' : '',
								]}
							>
								{item.label}
							</a>
						))}
					</nav>

					<div class="mt-4 flex items-center gap-3 border-t border-[#ece7db] pt-4">
						<a
							data-admin-nav-link
							class="hidden rounded-full border border-[#d9ddcf] bg-[#eef2eb] px-4 py-2 text-center text-sm font-medium text-[#4f7557] transition hover:border-[#c8d3c4] hover:bg-[#e7efe4]"
							href="/admin"
						>
							Backoffice
						</a>
						<a
							data-auth-link
							class="flex-1 rounded-full border border-[#dddcd2] bg-white px-4 py-2 text-center text-sm font-medium text-[#5e675d] transition hover:border-[#c8d3c4] hover:text-[#4f7557]"
							href="/connexion"
						>
							Connexion
						</a>
						<a
							class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-[#dddcd2] bg-white text-[#5e675d] transition hover:border-[#c8d3c4] hover:text-[#4f7557]"
							href="/recherche"
							aria-label="Voir les recettes"
						>
							<svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<circle cx="11" cy="11" r="6.5"></circle>
								<path d="M16 16L21 21"></path>
							</svg>
						</a>
					</div>
				</div>
			</header>

			<slot />

			<footer class="mx-auto mt-8 max-w-[1240px] border-t border-[#dddcd1] px-4 py-8 text-[#667064] sm:px-6">
				<div class="grid gap-8 lg:grid-cols-[1.3fr_1fr_1fr_1fr]">
					<div class="space-y-4">
						<div class="flex items-center gap-3">
							<img
								src="/logo-nutriguide.svg"
								alt="NutriGuide"
								class="h-10 w-10 shrink-0"
								loading="lazy"
							/>
							<span class="text-[15px] font-semibold text-[#314033]">NutriGuide</span>
						</div>
						<p class="max-w-[220px] text-sm leading-6">
							Votre guide pour mieux choisir vos aliments, recettes et reperes nutritionnels.
						</p>
					</div>

					<div class="space-y-3">
						<h4 class="text-sm font-semibold text-[#314033]">Navigation</h4>
						<div class="grid gap-2 text-sm">
							<a href="/regimes">Regimes alimentaires</a>
							<a href="/aliments">Aliments</a>
							<a href="/recettes">Recettes</a>
							<a href="/calculateur">Calculateur</a>
							<a href="/conseils">Conseils nutrition</a>
							<a href="/admin/connexion">Backoffice</a>
						</div>
					</div>

					<div class="space-y-3">
						<h4 class="text-sm font-semibold text-[#314033]">Informations</h4>
						<div class="grid gap-2 text-sm">
							<a href="/">Accueil</a>
							<span>A propos</span>
							<span>Contact</span>
							<span>Confidentialite</span>
						</div>
					</div>

					<div class="space-y-3">
						<h4 class="text-sm font-semibold text-[#314033]">Newsletter</h4>
						<p class="text-sm leading-6">Recevez vos conseils nutrition chaque semaine.</p>
						<div class="flex max-w-[240px] items-center gap-2">
							<input
								type="email"
								placeholder="Votre email"
								class="min-w-0 flex-1 rounded-[10px] border border-[#d9ddcf] bg-white px-3 py-2 text-sm outline-none placeholder:text-[#9aa196]"
							/>
							<button class="rounded-[10px] bg-[#5d8765] px-3 py-2 text-sm font-semibold text-white transition hover:bg-[#4f7557]">
								OK
							</button>
						</div>
					</div>
				</div>
				<div class="mt-8 border-t border-[#e6e0d5] pt-5 text-center text-sm text-[#7a8177]">
					© 2026 NutriGuide. Tous droits reserves.
				</div>
			</footer>
		</div>
		<script>
			import { getStoredAdminAuth, getStoredAuth, isSuperuserModel } from '../lib/pocketbase-browser';

			const authLinks = Array.from(document.querySelectorAll('[data-auth-link]'));
			const adminLinks = Array.from(document.querySelectorAll('[data-admin-nav-link]'));
			const auth = getStoredAuth();
			const adminAuth = getStoredAdminAuth();
			const mobileMenuButton = document.querySelector('#mobile-menu-button');
			const mobileMenu = document.querySelector('#mobile-menu');

			if (authLinks.length > 0 && auth?.model) {
				authLinks.forEach((authLink) => {
					authLink.setAttribute('href', '/profil');
					authLink.textContent = 'Profil';
				});
			}

			if (adminLinks.length > 0 && adminAuth?.token && isSuperuserModel(adminAuth.model)) {
				adminLinks.forEach((adminLink) => {
					adminLink.classList.remove('hidden');
				});
			}

			mobileMenuButton?.addEventListener('click', () => {
				const isOpen = mobileMenuButton.getAttribute('aria-expanded') === 'true';
				mobileMenuButton.setAttribute('aria-expanded', String(!isOpen));
				mobileMenu?.classList.toggle('hidden', isOpen);
			});

			mobileMenu?.querySelectorAll('a').forEach((link) => {
				link.addEventListener('click', () => {
					mobileMenuButton?.setAttribute('aria-expanded', 'false');
					mobileMenu.classList.add('hidden');
				});
			});

			window.addEventListener('resize', () => {
				if (window.innerWidth >= 1024) {
					mobileMenuButton?.setAttribute('aria-expanded', 'false');
					mobileMenu?.classList.add('hidden');
				}
			});
		</script>
	</body>
</html>
