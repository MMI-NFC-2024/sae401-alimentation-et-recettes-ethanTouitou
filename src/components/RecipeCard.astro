---
interface Props {
  title: string;
  summary: string;
  imageUrl?: string | null;
  servings: number;
  totalTime: number;
  calories: number;
  hasTime: boolean;
  hasNutrition: boolean;
  tags: string[];
  href?: string;
}

const {
  title,
  summary,
  imageUrl = null,
  servings,
  totalTime,
  calories,
  hasTime,
  hasNutrition,
  tags = [],
  href,
} = Astro.props;
---

{href ? (
  <a href={href} class="group block overflow-hidden rounded-[22px] border border-[#e6dfd3] bg-white shadow-[0_18px_36px_rgba(76,82,58,0.06)] transition duration-200 hover:-translate-y-1">
    <div class="aspect-[1.18/1] bg-[linear-gradient(135deg,#d7dfd3,#edf0e6)]">
      {imageUrl ? (
        <img class="h-full w-full object-cover" src={imageUrl} alt={title} loading="lazy" />
      ) : (
        <div class="flex h-full w-full items-center justify-center text-3xl font-bold text-[#55755b]">
          {title.slice(0, 2).toUpperCase()}
        </div>
      )}
    </div>

    <div class="space-y-3 p-5">
      <h3 class="text-[22px] font-medium tracking-[-0.03em] text-[#314033] transition group-hover:text-[#4f7557]">{title}</h3>
      <p class="text-[14px] leading-6 text-[#6b7569]">{summary}</p>

      <div class="flex flex-wrap gap-x-4 gap-y-2 text-[13px] text-[#6b7569]">
        <span>{hasTime ? `${totalTime} min` : 'Temps a completer'}</span>
        <span>{hasNutrition ? `${calories} kcal` : 'Macros a completer'}</span>
        <span>{servings > 0 ? `${servings} portions` : 'Portions non renseignees'}</span>
      </div>

      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="rounded-full bg-[#eef2eb] px-3 py-1 text-[11px] font-medium text-[#556a59]">{tag}</span>
          ))}
        </div>
      )}
    </div>
  </a>
) : (
  <article class="overflow-hidden rounded-[22px] border border-[#e6dfd3] bg-white shadow-[0_18px_36px_rgba(76,82,58,0.06)] transition duration-200 hover:-translate-y-1">
    <div class="aspect-[1.18/1] bg-[linear-gradient(135deg,#d7dfd3,#edf0e6)]">
      {imageUrl ? (
        <img class="h-full w-full object-cover" src={imageUrl} alt={title} loading="lazy" />
      ) : (
        <div class="flex h-full w-full items-center justify-center text-3xl font-bold text-[#55755b]">
          {title.slice(0, 2).toUpperCase()}
        </div>
      )}
    </div>

    <div class="space-y-3 p-5">
      <h3 class="text-[22px] font-medium tracking-[-0.03em] text-[#314033]">{title}</h3>
      <p class="text-[14px] leading-6 text-[#6b7569]">{summary}</p>

      <div class="flex flex-wrap gap-x-4 gap-y-2 text-[13px] text-[#6b7569]">
        <span>{hasTime ? `${totalTime} min` : 'Temps a completer'}</span>
        <span>{hasNutrition ? `${calories} kcal` : 'Macros a completer'}</span>
        <span>{servings > 0 ? `${servings} portions` : 'Portions non renseignees'}</span>
      </div>

      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="rounded-full bg-[#eef2eb] px-3 py-1 text-[11px] font-medium text-[#556a59]">{tag}</span>
          ))}
        </div>
      )}
    </div>
  </article>
)}
