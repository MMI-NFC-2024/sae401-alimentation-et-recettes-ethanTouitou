---
import RecipeCard from '../../components/RecipeCard.astro';
import Layout from '../../layouts/Layout.astro';
import { getRecipesPageData } from '../../lib/local-pocketbase';

const pageData = getRecipesPageData();
---

<Layout
  title="NutriGuide | Recettes"
  description="Toutes les recettes disponibles dans votre base PocketBase locale."
  currentPath="/recettes"
>
  <main class="mx-auto max-w-[1240px] px-4 py-10 sm:px-6 sm:py-14">
    <section class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-[2.5rem] font-semibold tracking-[-0.04em] text-[#314033] sm:text-[3.2rem]">
          Recettes
        </h1>
        <p class="mt-4 max-w-[780px] text-[16px] leading-8 text-[#6b7569]">
          Retrouvez toutes les recettes de votre base. Vous pouvez aussi les filtrer par regime alimentaire depuis la page Regimes.
        </p>
      </div>

      <a class="text-sm font-medium text-[#4f7557]" href="/regimes">
        Voir les regimes
      </a>
    </section>

    <section class="mt-8 flex flex-wrap gap-2">
      <a
        href="/recettes"
        class="rounded-full bg-[#5d8765] px-4 py-2 text-sm font-medium text-white"
      >
        Toutes
      </a>
      {pageData.dietTypes.map((diet) => (
        <a
          href={`/recettes/regime/${diet.slug}`}
          class="rounded-full bg-white px-4 py-2 text-sm font-medium text-[#556a59] shadow-[0_8px_24px_rgba(76,82,58,0.05)]"
        >
          {diet.name}
        </a>
      ))}
      {pageData.nutritionGoals.map((goal) => (
        <a
          href={`/recettes/objectif/${goal.slug}`}
          class="rounded-full bg-[#eef2eb] px-4 py-2 text-sm font-medium text-[#556a59] shadow-[0_8px_24px_rgba(76,82,58,0.05)]"
        >
          {goal.name}
        </a>
      ))}
    </section>

    <section class="mt-10">
      <div class="grid gap-4 lg:grid-cols-3">
        {pageData.recipes.map((recipe) => (
          <RecipeCard {...recipe} href={`/recettes/${recipe.slug}`} />
        ))}
      </div>
    </section>
  </main>
</Layout>
