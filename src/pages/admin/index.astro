---
import Layout from '../../layouts/Layout.astro';
import { getHomePageData } from '../../lib/local-pocketbase';

const homeData = getHomePageData();
const foods = homeData.foods.map((food) => ({
  id: food.id,
  name: food.name,
}));
const dietTypes = homeData.dietTypes.map((diet) => ({
  id: diet.id,
  name: diet.name,
}));
const nutritionGoals = homeData.nutritionGoals.map((goal) => ({
  id: goal.id,
  name: goal.name,
}));
---

<Layout
  title="NutriGuide | Backoffice"
  description="Backoffice d administration pour ajouter des aliments et des recettes."
>
  <main class="mx-auto max-w-[1240px] px-4 py-10 sm:px-6 sm:py-14">
    <section class="mx-auto max-w-[1160px]">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#7d8478]">
            Backoffice
          </p>
          <h1 class="mt-3 text-[2.7rem] font-semibold tracking-[-0.04em] text-[#314033]">
            Gestion du contenu
          </h1>
          <p class="mt-4 max-w-[760px] text-[16px] leading-8 text-[#6b7569]">
            Ajoutez des aliments et des recettes directement depuis le front du site, avec les relations PocketBase necessaires.
          </p>
        </div>

        <div class="flex flex-wrap gap-3">
          <div class="rounded-full bg-[#eef2eb] px-4 py-2 text-sm font-medium text-[#556a59]">
            <span id="admin-user-label">Session admin</span>
          </div>
          <button
            id="admin-logout-button"
            type="button"
            class="rounded-full border border-[#dddcd2] bg-white px-4 py-2 text-sm font-medium text-[#5e675d] transition hover:border-[#c8d3c4] hover:text-[#4f7557]"
          >
            Se deconnecter
          </button>
        </div>
      </div>

      <div id="admin-global-status" class="mt-5 hidden rounded-[12px] border px-4 py-3 text-sm"></div>

      <div class="mt-10 grid gap-6 xl:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]">
        <section class="rounded-[24px] border border-[#e4ddcf] bg-white p-6 shadow-[0_18px_36px_rgba(76,82,58,0.06)]">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="text-[1.9rem] font-semibold tracking-[-0.03em] text-[#314033]">
                Ajouter un aliment
              </h2>
              <p class="mt-2 text-[15px] leading-7 text-[#6b7569]">
                Creez une fiche aliment complete avec ses valeurs nutritionnelles et ses liens vers les regimes ou objectifs.
              </p>
            </div>
            <div class="rounded-full bg-[#f4f7f1] px-4 py-2 text-sm font-medium text-[#556a59]">
              {foods.length} aliments existants
            </div>
          </div>

          <div id="food-form-status" class="mt-5 hidden rounded-[12px] border px-4 py-3 text-sm"></div>

          <form id="food-form" class="mt-6 space-y-5">
            <div class="grid gap-4 md:grid-cols-2">
              <label class="block space-y-2">
                <span class="text-sm font-medium text-[#314033]">Nom</span>
                <input name="name" required class="w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition focus:border-[#8aac90]" placeholder="Ex: Amande" />
              </label>

              <label class="block space-y-2">
                <span class="text-sm font-medium text-[#314033]">Slug</span>
                <input name="slug" class="w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition focus:border-[#8aac90]" placeholder="Genere automatiquement si vide" />
              </label>
            </div>

            <label class="block space-y-2">
              <span class="text-sm font-medium text-[#314033]">Resume court</span>
              <input name="short_description" class="w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition focus:border-[#8aac90]" placeholder="Une phrase courte pour les cartes." />
            </label>

            <label class="block space-y-2">
              <span class="text-sm font-medium text-[#314033]">Description</span>
              <textarea name="description" rows="4" class="w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition focus:border-[#8aac90]" placeholder="Description detaillee de l aliment."></textarea>
            </label>

            <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
              <label class="block space-y-2">
                <span class="text-sm font-medium text-[#314033]">Calories / 100g</span>
                <input name="calories_per_100g" type="number" min="0" step="0.1" required class="w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition focus:border-[#8aac90]" />
              </label>
              <label class="block space-y-2">
                <span class="text-sm font-medium text-[#314033]">Proteines / 100g</span>
                <input name="protein_per_100g" type="number" min="0" step="0.1" required class="w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition focus:border-[#8aac90]" />
              </label>
              <label class="block space-y-2">
                <span class="text-sm font-medium text-[#314033]">Glucides / 100g</span>
                <input name="carbs_per_100g" type="number" min="0" step="0.1" required class="w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition focus:border-[#8aac90]" />
              </label>
              <label class="block space-y-2">
                <span class="text-sm font-medium text-[#314033]">Lipides / 100g</span>
                <input name="fat_per_100g" type="number" min="0" step="0.1" required class="w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition focus:border-[#8aac90]" />
              </label>
              <label class="block space-y-2">
                <span class="text-sm font-medium text-[#314033]">Fibres / 100g</span>
                <input name="fiber_per_100g" type="number" min="0" step="0.1" required class="w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition focus:border-[#8aac90]" />
              </label>
              <label class="block space-y-2">
                <span class="text-sm font-medium text-[#314033]">Sodium / 100g</span>
                <input name="sodium_per_100g" type="number" min="0" step="0.1" class="w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition focus:border-[#8aac90]" />
              </label>
            </div>

            <div class="grid gap-4 md:grid-cols-2">
              <label class="block space-y-2">
                <span class="text-sm font-medium text-[#314033]">Regimes lies</span>
                <select name="diet_types" multiple class="min-h-[168px] w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition focus:border-[#8aac90]">
                  {dietTypes.map((diet) => (
                    <option value={diet.id}>{diet.name}</option>
                  ))}
                </select>
              </label>

              <label class="block space-y-2">
                <span class="text-sm font-medium text-[#314033]">Objectifs lies</span>
                <select name="nutrition_goals" multiple class="min-h-[168px] w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition focus:border-[#8aac90]">
                  {nutritionGoals.map((goal) => (
                    <option value={goal.id}>{goal.name}</option>
                  ))}
                </select>
              </label>
            </div>

            <label class="block space-y-2">
              <span class="text-sm font-medium text-[#314033]">Image</span>
              <input
                name="image"
                type="file"
                accept="image/png,image/jpeg,image/webp,image/gif"
                class="w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition file:mr-4 file:rounded-full file:border-0 file:bg-[#eef2eb] file:px-3 file:py-2 file:text-sm file:font-medium file:text-[#4f7557]"
              />
            </label>

            <button class="w-full rounded-[12px] bg-[#5d8765] px-4 py-3 text-sm font-semibold text-white transition hover:bg-[#4f7557]">
              Ajouter cet aliment
            </button>
          </form>
        </section>

        <section class="rounded-[24px] border border-[#e4ddcf] bg-white p-6 shadow-[0_18px_36px_rgba(76,82,58,0.06)]">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="text-[1.9rem] font-semibold tracking-[-0.03em] text-[#314033]">
                Ajouter une recette
              </h2>
              <p class="mt-2 text-[15px] leading-7 text-[#6b7569]">
                Creez une recette avec ses portions, son image et ses ingredients relies a vos aliments existants.
              </p>
            </div>
            <div class="rounded-full bg-[#f4f7f1] px-4 py-2 text-sm font-medium text-[#556a59]">
              {homeData.recipes.length} recettes existantes
            </div>
          </div>

          <div id="recipe-form-status" class="mt-5 hidden rounded-[12px] border px-4 py-3 text-sm"></div>

          <form id="recipe-form" class="mt-6 space-y-5">
            <div class="grid gap-4 md:grid-cols-2">
              <label class="block space-y-2">
                <span class="text-sm font-medium text-[#314033]">Titre</span>
                <input name="title" required class="w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition focus:border-[#8aac90]" placeholder="Ex: Salade quinoa feta" />
              </label>

              <label class="block space-y-2">
                <span class="text-sm font-medium text-[#314033]">Slug</span>
                <input name="slug" class="w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition focus:border-[#8aac90]" placeholder="Genere automatiquement si vide" />
              </label>
            </div>

            <label class="block space-y-2">
              <span class="text-sm font-medium text-[#314033]">Resume</span>
              <input name="excerpt" class="w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition focus:border-[#8aac90]" placeholder="Texte court pour les cartes recettes." />
            </label>

            <label class="block space-y-2">
              <span class="text-sm font-medium text-[#314033]">Description / contenu</span>
              <textarea name="content" rows="4" class="w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition focus:border-[#8aac90]" placeholder="Description detaillee de la recette."></textarea>
            </label>

            <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
              <label class="block space-y-2">
                <span class="text-sm font-medium text-[#314033]">Parts de base</span>
                <input name="base_servings" type="number" min="1" step="1" required value="2" class="w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition focus:border-[#8aac90]" />
              </label>
              <label class="block space-y-2">
                <span class="text-sm font-medium text-[#314033]">Preparation (min)</span>
                <input name="prep_time" type="number" min="0" step="1" class="w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition focus:border-[#8aac90]" />
              </label>
              <label class="block space-y-2">
                <span class="text-sm font-medium text-[#314033]">Cuisson (min)</span>
                <input name="cook_time" type="number" min="0" step="1" class="w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition focus:border-[#8aac90]" />
              </label>
              <label class="block space-y-2">
                <span class="text-sm font-medium text-[#314033]">Image</span>
                <input
                  name="image"
                  type="file"
                  accept="image/png,image/jpeg,image/webp,image/gif"
                  class="w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition file:mr-4 file:rounded-full file:border-0 file:bg-[#eef2eb] file:px-3 file:py-2 file:text-sm file:font-medium file:text-[#4f7557]"
                />
              </label>
            </div>

            <div class="grid gap-4 md:grid-cols-2">
              <label class="block space-y-2">
                <span class="text-sm font-medium text-[#314033]">Regimes lies</span>
                <select name="diet_types" multiple class="min-h-[168px] w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition focus:border-[#8aac90]">
                  {dietTypes.map((diet) => (
                    <option value={diet.id}>{diet.name}</option>
                  ))}
                </select>
              </label>

              <label class="block space-y-2">
                <span class="text-sm font-medium text-[#314033]">Objectifs lies</span>
                <select name="nutrition_goals" multiple class="min-h-[168px] w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition focus:border-[#8aac90]">
                  {nutritionGoals.map((goal) => (
                    <option value={goal.id}>{goal.name}</option>
                  ))}
                </select>
              </label>
            </div>

            <section class="rounded-[18px] bg-[#f7f3ec] p-5">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <h3 class="text-[1.3rem] font-semibold tracking-[-0.03em] text-[#314033]">
                    Ingredients
                  </h3>
                  <p class="mt-2 text-[14px] leading-6 text-[#6b7569]">
                    Chaque ligne cree ensuite un enregistrement dans `recipe_ingredients`.
                  </p>
                </div>
                <button
                  id="add-ingredient-row"
                  type="button"
                  class="rounded-[12px] border border-[#d8ddcf] bg-white px-4 py-2 text-sm font-medium text-[#314033] transition hover:border-[#8aac90] hover:text-[#4f7557]"
                >
                  Ajouter un ingredient
                </button>
              </div>

              <div id="ingredient-rows" class="mt-5 space-y-4"></div>
            </section>

            <button class="w-full rounded-[12px] bg-[#314033] px-4 py-3 text-sm font-semibold text-white transition hover:bg-[#263327]">
              Ajouter cette recette
            </button>
          </form>
        </section>
      </div>
    </section>
  </main>

  <script
    is:inline
    data-admin-options
    type="application/json"
    set:html={JSON.stringify({
      foods,
      units: ['g', 'kg', 'ml', 'cl', 'piece', 'cas', 'cac'],
    })}
  />

  <script>
    import {
      PB_URL,
      clearStoredAdminAuth,
      getStoredAdminAuth,
      isSuperuserModel,
      parsePocketBaseError,
    } from '../../lib/pocketbase-browser';

    const options = JSON.parse(document.querySelector('[data-admin-options]')?.textContent || '{}');
    const adminAuth = getStoredAdminAuth();
    const adminLabel = document.querySelector('#admin-user-label');
    const logoutButton = document.querySelector('#admin-logout-button');
    const globalStatusNode = document.querySelector('#admin-global-status');
    const foodForm = document.querySelector('#food-form');
    const recipeForm = document.querySelector('#recipe-form');
    const foodFormStatus = document.querySelector('#food-form-status');
    const recipeFormStatus = document.querySelector('#recipe-form-status');
    const ingredientRows = document.querySelector('#ingredient-rows');
    const addIngredientRowButton = document.querySelector('#add-ingredient-row');

    const foods = Array.isArray(options.foods) ? options.foods.slice() : [];
    const units = Array.isArray(options.units) ? options.units : ['g', 'piece'];

    const showStatus = (node, message, tone = 'success') => {
      if (!node) return;
      node.textContent = message;
      node.className = `mt-5 rounded-[12px] border px-4 py-3 text-sm ${tone === 'error' ? 'border-[#e4b6b1] bg-[#fff4f3] text-[#8a4b43]' : 'border-[#d2dfcd] bg-[#f5faf3] text-[#4f7557]'}`;
      node.classList.remove('hidden');
    };

    const hideStatus = (node) => {
      node?.classList.add('hidden');
    };

    if (!adminAuth?.token || !isSuperuserModel(adminAuth.model)) {
      window.location.href = '/admin/connexion';
    }

    if (adminLabel && adminAuth?.model) {
      adminLabel.textContent = adminAuth.model.email || 'Session admin';
    }

    const slugify = (value) =>
      String(value || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .slice(0, 80);

    const appendMultiRelation = (formData, fieldName, values) => {
      values.forEach((value) => {
        if (value) {
          formData.append(fieldName, value);
        }
      });
    };

    const authHeaders = () => ({
      Authorization: adminAuth.token,
    });

    const createFoodOptionHtml = (selectedValue = '') =>
      foods
        .map(
          (food) =>
            `<option value="${food.id}" ${food.id === selectedValue ? 'selected' : ''}>${food.name}</option>`,
        )
        .join('');

    const createUnitOptionHtml = (selectedValue = 'g') =>
      units
        .map(
          (unit) =>
            `<option value="${unit}" ${unit === selectedValue ? 'selected' : ''}>${unit}</option>`,
        )
        .join('');

    const refreshIngredientFoodOptions = () => {
      ingredientRows?.querySelectorAll('[data-ingredient-food]').forEach((select) => {
        const previousValue = select.value;
        select.innerHTML = `<option value="">Choisir un aliment</option>${createFoodOptionHtml(previousValue)}`;
      });
    };

    const addIngredientRow = (defaults = {}) => {
      if (!ingredientRows) return;

      const row = document.createElement('div');
      row.className = 'grid gap-3 rounded-[14px] border border-[#e4ddcf] bg-white p-4 lg:grid-cols-[minmax(0,1.5fr)_120px_120px_minmax(0,1fr)_auto]';
      row.innerHTML = `
        <label class="block space-y-2">
          <span class="text-sm font-medium text-[#314033]">Aliment</span>
          <select data-ingredient-food class="w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition focus:border-[#8aac90]">
            <option value="">Choisir un aliment</option>
            ${createFoodOptionHtml(defaults.food || '')}
          </select>
        </label>
        <label class="block space-y-2">
          <span class="text-sm font-medium text-[#314033]">Quantite</span>
          <input data-ingredient-quantity type="number" min="0" step="0.1" value="${defaults.quantity || ''}" class="w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition focus:border-[#8aac90]" />
        </label>
        <label class="block space-y-2">
          <span class="text-sm font-medium text-[#314033]">Unite</span>
          <select data-ingredient-unit class="w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition focus:border-[#8aac90]">
            ${createUnitOptionHtml(defaults.unit || 'g')}
          </select>
        </label>
        <label class="block space-y-2">
          <span class="text-sm font-medium text-[#314033]">Note</span>
          <input data-ingredient-notes type="text" value="${defaults.notes || ''}" class="w-full rounded-[12px] border border-[#d8ddcf] bg-[#fcfcfa] px-4 py-3 text-sm outline-none transition focus:border-[#8aac90]" placeholder="Ex: cuit, grille..." />
        </label>
        <div class="flex items-end">
          <button type="button" data-remove-ingredient-row class="w-full rounded-[12px] border border-[#e4b6b1] bg-[#fff4f3] px-4 py-3 text-sm font-medium text-[#8a4b43] transition hover:border-[#d49d97]">
            Retirer
          </button>
        </div>
      `;

      row.querySelector('[data-remove-ingredient-row]')?.addEventListener('click', () => {
        row.remove();
      });

      ingredientRows.appendChild(row);
    };

    logoutButton?.addEventListener('click', () => {
      clearStoredAdminAuth();
      window.location.href = '/admin/connexion';
    });

    addIngredientRowButton?.addEventListener('click', () => {
      addIngredientRow();
    });

    if (ingredientRows && ingredientRows.children.length === 0) {
      addIngredientRow();
      addIngredientRow();
    }

    foodForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      hideStatus(foodFormStatus);
      hideStatus(globalStatusNode);

      const formData = new FormData(foodForm);
      const name = String(formData.get('name') || '').trim();
      const slug = String(formData.get('slug') || '').trim() || slugify(name);
      const imageFile = foodForm.querySelector('input[name="image"]')?.files?.[0];

      const payload = new FormData();
      payload.append('name', name);
      payload.append('slug', slug);
      payload.append('short_description', String(formData.get('short_description') || '').trim());
      payload.append('description', String(formData.get('description') || '').trim());
      payload.append('calories_per_100g', String(formData.get('calories_per_100g') || 0));
      payload.append('protein_per_100g', String(formData.get('protein_per_100g') || 0));
      payload.append('carbs_per_100g', String(formData.get('carbs_per_100g') || 0));
      payload.append('fat_per_100g', String(formData.get('fat_per_100g') || 0));
      payload.append('fiber_per_100g', String(formData.get('fiber_per_100g') || 0));
      payload.append('sodium_per_100g', String(formData.get('sodium_per_100g') || 0));
      appendMultiRelation(payload, 'diet_types', Array.from(foodForm.querySelector('select[name="diet_types"]')?.selectedOptions || []).map((option) => option.value));
      appendMultiRelation(payload, 'nutrition_goals', Array.from(foodForm.querySelector('select[name="nutrition_goals"]')?.selectedOptions || []).map((option) => option.value));

      if (imageFile) {
        payload.append('image', imageFile);
      }

      try {
        const response = await fetch('/api/admin/foods', {
          method: 'POST',
          headers: authHeaders(),
          body: payload,
        });
        const createdFood = await response.json();

        if (!response.ok) {
          throw new Error(parsePocketBaseError(createdFood));
        }

        foods.push({ id: createdFood.id, name: createdFood.name });
        foods.sort((a, b) => a.name.localeCompare(b.name, 'fr'));
        refreshIngredientFoodOptions();
        foodForm.reset();
        showStatus(foodFormStatus, 'Aliment ajoute avec succes.');
        showStatus(globalStatusNode, `Nouvel aliment cree: ${createdFood.name}.`);
      } catch (error) {
        showStatus(foodFormStatus, error instanceof Error ? error.message : 'Creation de l aliment impossible.', 'error');
      }
    });

    recipeForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      hideStatus(recipeFormStatus);
      hideStatus(globalStatusNode);

      const formData = new FormData(recipeForm);
      const title = String(formData.get('title') || '').trim();
      const slug = String(formData.get('slug') || '').trim() || slugify(title);
      const imageFile = recipeForm.querySelector('input[name="image"]')?.files?.[0];
      const ingredientPayload = Array.from(ingredientRows?.children || [])
        .map((row) => ({
          food: row.querySelector('[data-ingredient-food]')?.value || '',
          quantity: row.querySelector('[data-ingredient-quantity]')?.value || '',
          unit: row.querySelector('[data-ingredient-unit]')?.value || 'g',
          notes: row.querySelector('[data-ingredient-notes]')?.value || '',
        }))
        .filter((item) => item.food && item.quantity);

      if (ingredientPayload.length === 0) {
        showStatus(recipeFormStatus, 'Ajoutez au moins un ingredient valide.', 'error');
        return;
      }

      const payload = new FormData();
      payload.append('title', title);
      payload.append('slug', slug);
      payload.append('excerpt', String(formData.get('excerpt') || '').trim());
      payload.append('content', String(formData.get('content') || '').trim());
      payload.append('base_servings', String(formData.get('base_servings') || 1));
      payload.append('prep_time', String(formData.get('prep_time') || 0));
      payload.append('cook_time', String(formData.get('cook_time') || 0));
      appendMultiRelation(payload, 'diet_types', Array.from(recipeForm.querySelector('select[name="diet_types"]')?.selectedOptions || []).map((option) => option.value));
      appendMultiRelation(payload, 'nutrition_goals', Array.from(recipeForm.querySelector('select[name="nutrition_goals"]')?.selectedOptions || []).map((option) => option.value));

      if (imageFile) {
        payload.append('image', imageFile);
      }

      payload.append('ingredients', JSON.stringify(ingredientPayload));

      try {
        const recipeResponse = await fetch('/api/admin/recipes', {
          method: 'POST',
          headers: authHeaders(),
          body: payload,
        });
        const createdRecipe = await recipeResponse.json();

        if (!recipeResponse.ok) {
          throw new Error(parsePocketBaseError(createdRecipe));
        }

        recipeForm.reset();
        ingredientRows.innerHTML = '';
        addIngredientRow();
        addIngredientRow();
        showStatus(recipeFormStatus, 'Recette et ingredients ajoutes avec succes.');
        showStatus(globalStatusNode, `Nouvelle recette creee: ${createdRecipe.recipe?.title || title}.`);
      } catch (error) {
        showStatus(recipeFormStatus, error instanceof Error ? error.message : 'Creation de la recette impossible.', 'error');
      }
    });
  </script>
</Layout>
