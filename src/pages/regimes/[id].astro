---
import RecipeCard from '../../components/RecipeCard.astro';
import Layout from '../../layouts/Layout.astro';
import { getDietDetailData, getHomePageData } from '../../lib/local-pocketbase';

export function getStaticPaths() {
  const data = getHomePageData();

  return data.dietTypes.map((diet) => ({
    params: { id: diet.slug },
  }));
}

const { id } = Astro.params;
const diet = id ? getDietDetailData(id) : null;

if (!diet) {
  throw new Error(`Diet not found for ${id}`);
}
---

<Layout
  title={`NutriGuide | ${diet.name}`}
  description={diet.description}
  currentPath="/regimes"
>
  <main class="mx-auto max-w-[1240px] px-4 py-10 sm:px-6 sm:py-14">
    <section class="flex flex-col gap-6 rounded-[28px] bg-[linear-gradient(180deg,#eef4ea,#f8f5ee)] px-6 py-8 sm:px-8">
      <a class="text-sm font-medium text-[#4f7557]" href="/regimes">
        Retour aux regimes
      </a>

      <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-[14px] bg-[#5d8765] text-sm font-bold tracking-[0.14em] text-white">
            {diet.icon}
          </div>
          <h1 class="text-[2.7rem] font-semibold tracking-[-0.04em] text-[#314033]">
            {diet.name}
          </h1>
          <p class="mt-4 max-w-[760px] text-[16px] leading-8 text-[#6b7569]">
            {diet.description}
          </p>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          <div class="rounded-[18px] border border-white/80 bg-white/80 px-5 py-4">
            <div class="text-[28px] font-semibold tracking-[-0.04em] text-[#314033]">{diet.recipeCount}</div>
            <div class="text-sm text-[#6b7569]">recettes liees</div>
          </div>
          <div class="rounded-[18px] border border-white/80 bg-white/80 px-5 py-4">
            <div class="text-[28px] font-semibold tracking-[-0.04em] text-[#314033]">{diet.foodCount}</div>
            <div class="text-sm text-[#6b7569]">aliments compatibles</div>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-[2rem] font-semibold tracking-[-0.03em] text-[#314033]">Recettes compatibles</h2>

      {diet.recipes.length > 0 ? (
        <div class="mt-5 grid gap-4 lg:grid-cols-3">
          {diet.recipes.map((recipe) => (
            <RecipeCard {...recipe} href={`/recettes/${recipe.slug}`} />
          ))}
        </div>
      ) : (
        <article class="mt-5 rounded-[22px] border border-[#e6dfd3] bg-white p-6 shadow-[0_18px_36px_rgba(76,82,58,0.06)]">
          <h3 class="text-[19px] font-medium tracking-[-0.02em] text-[#314033]">Aucune recette pour ce regime</h3>
          <p class="mt-2 text-[14px] leading-6 text-[#6b7569]">
            Ajoutez d autres relations `diet_types` a vos recettes dans PocketBase pour enrichir cette page.
          </p>
        </article>
      )}
    </section>

    <section class="mt-10">
      <h2 class="text-[2rem] font-semibold tracking-[-0.03em] text-[#314033]">Aliments a privilegier</h2>

      {diet.foods.length > 0 ? (
        <div class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          {diet.foods.map((food) => (
            <a
              href={`/aliments/${food.slug}`}
              class="rounded-[22px] border border-[#e6dfd3] bg-white p-5 shadow-[0_18px_36px_rgba(76,82,58,0.06)] transition duration-200 hover:-translate-y-1"
            >
              <h3 class="text-[20px] font-medium tracking-[-0.03em] text-[#314033]">{food.name}</h3>
              <p class="mt-2 text-[14px] leading-6 text-[#6b7569]">{food.summary}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {food.tags.slice(0, 2).map((tag) => (
                  <span class="rounded-full bg-[#eef2eb] px-3 py-1 text-[11px] font-medium text-[#556a59]">{tag}</span>
                ))}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <article class="mt-5 rounded-[22px] border border-[#e6dfd3] bg-white p-6 shadow-[0_18px_36px_rgba(76,82,58,0.06)]">
          <h3 class="text-[19px] font-medium tracking-[-0.02em] text-[#314033]">Aucun aliment associe</h3>
          <p class="mt-2 text-[14px] leading-6 text-[#6b7569]">
            Des que des aliments seront relies a ce regime dans PocketBase, ils apparaitront ici.
          </p>
        </article>
      )}
    </section>
  </main>
</Layout>
