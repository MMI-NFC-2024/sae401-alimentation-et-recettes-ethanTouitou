---
import Layout from '../layouts/Layout.astro';
import { getHomePageData } from '../lib/local-pocketbase';

type AdviceCategoryKey = 'proteines' | 'perte-de-poids' | 'equilibre' | 'nutrition' | 'bien-etre';

type AdviceArticle = {
  id: string;
  title: string;
  excerpt: string;
  categoryKey: AdviceCategoryKey;
  categoryLabel: string;
  icon: string;
  readTime: number;
  paragraphs: string[];
  takeaways: string[];
};

const homeData = getHomePageData();
const topProteinFood = homeData.foods[0]?.name || 'vos meilleures sources de proteines';
const topFiberFood = [...homeData.foods].sort((a, b) => b.fiber - a.fiber)[0]?.name || 'les aliments riches en fibres';
const lightestRecipe = [...homeData.recipes].sort((a, b) => a.calories - b.calories)[0]?.title || 'une recette legere';

const categoryMeta: Record<AdviceCategoryKey, { label: string; icon: string }> = {
  proteines: { label: 'Proteines', icon: 'PR' },
  'perte-de-poids': { label: 'Perte de poids', icon: 'PP' },
  equilibre: { label: 'Equilibre', icon: 'EQ' },
  nutrition: { label: 'Nutrition', icon: 'NT' },
  'bien-etre': { label: 'Bien-etre', icon: 'BE' },
};

function stripHtml(value: string) {
  return value.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
}

function estimateReadTime(text: string) {
  const words = stripHtml(text).split(/\s+/).filter(Boolean).length;
  return Math.max(4, Math.round(words / 160));
}

function inferCategory(title: string, text: string): AdviceCategoryKey {
  const haystack = `${title} ${text}`.toLowerCase();

  if (haystack.includes('proteine')) return 'proteines';
  if (haystack.includes('poids') || haystack.includes('rassasi') || haystack.includes('deficit')) return 'perte-de-poids';
  if (haystack.includes('hydrat') || haystack.includes('energie') || haystack.includes('recuper')) return 'bien-etre';
  if (haystack.includes('equilibr') || haystack.includes('assiette') || haystack.includes('repas')) return 'equilibre';
  return 'nutrition';
}

function buildTakeaways(categoryKey: AdviceCategoryKey) {
  const takeawaysByCategory: Record<AdviceCategoryKey, string[]> = {
    proteines: [
      'Visez une presence proteique a chaque repas principal.',
      'Alternez sources animales et vegetales selon vos habitudes.',
      `Utilisez ${topProteinFood} comme repere si vous cherchez un aliment plus riche en proteines.`,
    ],
    'perte-de-poids': [
      'Cherchez la satiete avant de chercher la restriction maximale.',
      `Appuyez-vous sur ${topFiberFood} et les aliments riches en fibres pour mieux tenir dans la journee.`,
      'Gardez un deficit calorique progressif plutot qu une approche trop agressive.',
    ],
    equilibre: [
      'Conservez une base simple: legumes, proteines, feculents et matieres grasses de qualite.',
      'Ajustez les portions selon votre faim, votre activite et votre objectif.',
      `Si vous manquez d idees, partez d une recette comme ${lightestRecipe} puis adaptez-la.`,
    ],
    nutrition: [
      'Variez les familles d aliments pour mieux couvrir vos besoins.',
      'Ne jugez pas un aliment sur un seul macronutriment.',
      'Pensez aussi aux fibres, aux micronutriments et a la regularite des repas.',
    ],
    'bien-etre': [
      'Hydratation, sommeil et niveau de stress influencent aussi votre alimentation.',
      'Une strategie durable doit rester compatible avec votre quotidien.',
      'Cherchez la constance plutot que la perfection.',
    ],
  };

  return takeawaysByCategory[categoryKey];
}

function buildParagraphs(text: string, excerpt: string, categoryKey: AdviceCategoryKey) {
  const cleanedText = stripHtml(text);
  const cleanedExcerpt = stripHtml(excerpt);
  const paragraphs = [cleanedExcerpt, cleanedText]
    .flatMap((entry) => entry.split(/\.\s+/))
    .map((entry) => entry.trim())
    .filter((entry) => entry.length > 45)
    .slice(0, 3)
    .map((entry) => (entry.endsWith('.') ? entry : `${entry}.`));

  if (paragraphs.length >= 2) {
    return paragraphs;
  }

  const fallbacks: Record<AdviceCategoryKey, string[]> = {
    proteines: [
      'Bien repartir ses proteines sur la journee aide a soutenir la satiere, la recuperation et le maintien de la masse musculaire.',
      'Le plus simple consiste a garder une source proteique identifiable au petit-dejeuner, au dejeuner et au diner, sans attendre le dernier repas pour tout concentrer.',
      `Dans votre base actuelle, ${topProteinFood} peut servir de point de depart si vous cherchez une option pratique a integrer.`,
    ],
    'perte-de-poids': [
      'Une perte de poids durable repose moins sur la suppression brutale de categories d aliments que sur la gestion de la faim et des portions.',
      'Les aliments les plus rassasiants combinent souvent eau, fibres, proteines ou un volume important dans l assiette, ce qui aide a mieux tenir entre les repas.',
      'L objectif est de rendre votre alimentation plus stable au quotidien, pas seulement de reduire vos calories pendant quelques jours.',
    ],
    equilibre: [
      'Composer une assiette equilibree revient a organiser un repas simple, lisible et regulier plutot qu a chercher une formule parfaite.',
      'Une base robuste consiste a associer une portion de proteines, des legumes, une source de glucides et une matiere grasse de qualite.',
      `Quand vous manquez de reperes, partez d une recette familiere comme ${lightestRecipe} puis ajustez les portions selon votre objectif.`,
    ],
    nutrition: [
      'Les bons reperes nutritionnels se construisent dans la repetion: variete, regularite, qualite globale des repas et adaptation a votre quotidien.',
      'Les legumineuses, les cereales completes, les fruits et les legumes apportent souvent des fibres et des micronutriments utiles pour la satiere et l equilibre digestif.',
      `Dans votre base actuelle, ${topFiberFood} illustre bien l interet de ne pas se limiter aux seules calories.`,
    ],
    'bien-etre': [
      'Le bien-etre nutritionnel ne depend pas uniquement des calories ou des macros. Hydratation, sommeil, stress et rythme des repas comptent aussi.',
      'Boire regulierement, manger a des heures plus stables et eviter les extremes permet souvent de mieux controler ses sensations alimentaires.',
      'Une bonne strategie est celle que vous pouvez suivre sereinement plusieurs semaines, sans fatigue mentale excessive.',
    ],
  };

  return fallbacks[categoryKey];
}

const fallbackArticles: AdviceArticle[] = [
  {
    id: 'proteines-journee',
    title: 'Comment bien repartir ses proteines dans la journee',
    excerpt: 'Apprenez a optimiser votre apport proteique tout au long de la journee pour de meilleurs resultats.',
    categoryKey: 'proteines',
    categoryLabel: categoryMeta.proteines.label,
    icon: categoryMeta.proteines.icon,
    readTime: 5,
    paragraphs: buildParagraphs('', 'Apprenez a optimiser votre apport proteique tout au long de la journee pour de meilleurs resultats.', 'proteines'),
    takeaways: buildTakeaways('proteines'),
  },
  {
    id: 'aliments-rassasiants',
    title: 'Les aliments les plus rassasiants pour perdre du poids',
    excerpt: 'Decouvrez quels aliments vous aident a controler votre faim naturellement et a atteindre vos objectifs.',
    categoryKey: 'perte-de-poids',
    categoryLabel: categoryMeta['perte-de-poids'].label,
    icon: categoryMeta['perte-de-poids'].icon,
    readTime: 6,
    paragraphs: buildParagraphs('', 'Decouvrez quels aliments vous aident a controler votre faim naturellement et a atteindre vos objectifs.', 'perte-de-poids'),
    takeaways: buildTakeaways('perte-de-poids'),
  },
  {
    id: 'assiette-equilibree',
    title: 'Composer une assiette equilibree',
    excerpt: 'Les proportions ideales pour un repas complet et nutritif qui soutient votre sante.',
    categoryKey: 'equilibre',
    categoryLabel: categoryMeta.equilibre.label,
    icon: categoryMeta.equilibre.icon,
    readTime: 4,
    paragraphs: buildParagraphs('', 'Les proportions ideales pour un repas complet et nutritif qui soutient votre sante.', 'equilibre'),
    takeaways: buildTakeaways('equilibre'),
  },
  {
    id: 'bienfaits-legumineuses',
    title: 'Les bienfaits des legumineuses',
    excerpt: 'Pourquoi integrer plus de legumineuses dans votre alimentation peut transformer votre sante.',
    categoryKey: 'nutrition',
    categoryLabel: categoryMeta.nutrition.label,
    icon: categoryMeta.nutrition.icon,
    readTime: 5,
    paragraphs: buildParagraphs('', 'Pourquoi integrer plus de legumineuses dans votre alimentation peut transformer votre sante.', 'nutrition'),
    takeaways: buildTakeaways('nutrition'),
  },
  {
    id: 'perte-durable',
    title: 'Perdre du poids de facon durable',
    excerpt: 'Les principes fondamentaux d une perte de poids saine et maintenue dans le temps.',
    categoryKey: 'perte-de-poids',
    categoryLabel: categoryMeta['perte-de-poids'].label,
    icon: categoryMeta['perte-de-poids'].icon,
    readTime: 7,
    paragraphs: buildParagraphs('', 'Les principes fondamentaux d une perte de poids saine et maintenue dans le temps.', 'perte-de-poids'),
    takeaways: buildTakeaways('perte-de-poids'),
  },
  {
    id: 'importance-hydratation',
    title: 'L importance de l hydratation',
    excerpt: 'Comment une bonne hydratation impacte votre metabolisme, votre energie et vos performances.',
    categoryKey: 'bien-etre',
    categoryLabel: categoryMeta['bien-etre'].label,
    icon: categoryMeta['bien-etre'].icon,
    readTime: 4,
    paragraphs: buildParagraphs('', 'Comment une bonne hydratation impacte votre metabolisme, votre energie et vos performances.', 'bien-etre'),
    takeaways: buildTakeaways('bien-etre'),
  },
];

const databaseArticles: AdviceArticle[] = homeData.articles
  .filter((article) => Number(article.is_published ?? 1) !== 0)
  .map((article, index) => {
    const combinedText = `${article.excerpt || ''} ${article.content || ''}`.trim();
    const categoryKey = inferCategory(article.title, combinedText);
    const meta = categoryMeta[categoryKey];

    return {
      id: article.slug || article.id || `article-${index + 1}`,
      title: article.title,
      excerpt: stripHtml(article.excerpt || 'Conseil nutrition recupere depuis votre base PocketBase.'),
      categoryKey,
      categoryLabel: meta.label,
      icon: meta.icon,
      readTime: estimateReadTime(combinedText || article.title),
      paragraphs: buildParagraphs(article.content || '', article.excerpt || '', categoryKey),
      takeaways: buildTakeaways(categoryKey),
    };
  });

const cardArticles: AdviceArticle[] = [];
const seenIds = new Set<string>();

for (const article of [...databaseArticles, ...fallbackArticles]) {
  if (seenIds.has(article.id)) continue;
  seenIds.add(article.id);
  cardArticles.push(article);
  if (cardArticles.length === 6) break;
}

const featuredArticle = {
  id: 'regles-or-equilibre',
  title: "Les 10 regles d'or d'une alimentation equilibree",
  excerpt:
    'Decouvrez les principes fondamentaux qui vous permettront de construire une alimentation saine, durable et adaptee a vos besoins. Des conseils simples et pratiques a appliquer au quotidien.',
  categoryKey: 'equilibre' as AdviceCategoryKey,
  categoryLabel: categoryMeta.equilibre.label,
  icon: categoryMeta.equilibre.icon,
  readTime: 8,
  paragraphs: [
    'Une alimentation equilibree ne repose pas sur un aliment parfait ni sur une journee parfaite. Elle se construit avec des reperes repetables: une assiette lisible, des horaires assez reguliers, des portions coherentes et une bonne adaptation a votre niveau d activite.',
    'Le cadre le plus simple consiste a donner une vraie place aux legumes, a garder une source de proteines sur les repas principaux, a ajuster les glucides selon votre depense et a ne pas diaboliser les matieres grasses de qualite. L enjeu n est pas la rigidite, mais la regularite.',
    'Quand un plan alimentaire devient trop complique, il devient souvent difficile a tenir. Mieux vaut quelques habitudes robustes appliquees presque tous les jours qu une strategie parfaite tenue seulement une semaine.',
  ],
  takeaways: [
    'Construisez vos repas autour de reperes simples et repetables.',
    'Ajustez les quantites selon votre objectif, pas seulement selon des regles generales.',
    'Gardez une approche durable, compatible avec votre quotidien et votre budget.',
  ],
};

const detailedArticles = [featuredArticle, ...cardArticles];
const quickStats = [
  {
    title: 'Base actuelle',
    value: `${homeData.articles.length} article(s) et ${homeData.recipes.length} recette(s)`,
    description: 'La page peut s enrichir automatiquement a mesure que vous ajoutez du contenu dans PocketBase.',
  },
  {
    title: 'Repere proteines',
    value: topProteinFood,
    description: 'Aliment actuellement mis en avant dans votre base pour sa densite proteique.',
  },
  {
    title: 'Repere satiete',
    value: topFiberFood,
    description: 'Bon point de depart si vous voulez renforcer les fibres et la satiere au quotidien.',
  },
];

const filterChips = [
  { key: 'all', label: 'Tous' },
  { key: 'proteines', label: 'Proteines' },
  { key: 'perte-de-poids', label: 'Perte de poids' },
  { key: 'equilibre', label: 'Equilibre' },
  { key: 'nutrition', label: 'Nutrition' },
  { key: 'bien-etre', label: 'Bien-etre' },
];
---

<Layout
  title="NutriGuide | Conseils nutrition"
  description="Articles et recommandations pour adopter une alimentation saine et atteindre vos objectifs nutritionnels."
  currentPath="/conseils"
>
  <main class="mx-auto max-w-[1240px] px-4 py-10 sm:px-6 sm:py-14">
    <section class="max-w-[860px]">
      <h1 class="text-[2.7rem] font-semibold tracking-[-0.05em] text-[#314033] sm:text-[3.4rem]">
        Conseils nutrition
      </h1>
      <p class="mt-5 text-[16px] leading-8 text-[#6b7569] sm:text-[17px]">
        Decouvrez nos articles et recommandations pour adopter une alimentation saine et atteindre vos objectifs nutritionnels.
      </p>
    </section>

    <section class="mt-10 flex flex-wrap gap-3">
      {filterChips.map((chip, index) => (
        <button
          type="button"
          data-advice-filter={chip.key}
          class:list={[
            'rounded-full border px-4 py-2 text-sm font-medium transition',
            index === 0
              ? 'border-[#d9ddcf] bg-[#eef2eb] text-[#314033]'
              : 'border-[#ece6db] bg-[#f5f1ea] text-[#536151] hover:border-[#d9ddcf] hover:bg-[#eef2eb]',
          ]}
        >
          {chip.label}
        </button>
      ))}
    </section>

    <section class="mt-8 grid gap-6 lg:grid-cols-3">
      {cardArticles.map((article) => (
        <a
          href={`#article-${article.id}`}
          data-advice-card
          data-category={article.categoryKey}
          class="rounded-[22px] border border-[#e6dfd3] bg-white p-6 shadow-[0_18px_36px_rgba(76,82,58,0.06)] transition duration-200 hover:-translate-y-1"
        >
          <div class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-[12px] bg-[#edf2ea] text-[12px] font-semibold tracking-[0.12em] text-[#58725d]">
            {article.icon}
          </div>
          <div class="text-[13px] font-medium uppercase tracking-[0.08em] text-[#5d8765]">
            {article.categoryLabel}
          </div>
          <h2 class="mt-3 text-[22px] font-medium tracking-[-0.03em] text-[#314033]">
            {article.title}
          </h2>
          <p class="mt-3 text-[15px] leading-8 text-[#6b7569]">
            {article.excerpt}
          </p>
          <div class="mt-5 text-sm text-[#788176]">
            {article.readTime} min de lecture
          </div>
        </a>
      ))}
    </section>

    <section
      id="advice-empty"
      class="mt-8 hidden rounded-[22px] border border-[#e6dfd3] bg-white p-6 text-center shadow-[0_18px_36px_rgba(76,82,58,0.06)]"
    >
      <h2 class="text-[1.8rem] font-semibold tracking-[-0.03em] text-[#314033]">Aucun conseil pour ce filtre</h2>
      <p class="mt-3 text-[15px] leading-7 text-[#6b7569]">
        Revenez sur "Tous" pour retrouver l ensemble des recommandations disponibles.
      </p>
    </section>

    <section class="mt-12 rounded-[22px] border border-[#e4ddcf] bg-[linear-gradient(180deg,#f5f7f4,#ffffff)] px-8 py-9 shadow-[0_18px_36px_rgba(76,82,58,0.05)]">
      <p class="text-[13px] font-medium uppercase tracking-[0.08em] text-[#5d8765]">Article populaire</p>
      <h2 class="mt-3 text-[2rem] font-semibold tracking-[-0.04em] text-[#314033] sm:text-[2.5rem]">
        {featuredArticle.title}
      </h2>
      <p class="mt-5 max-w-[860px] text-[17px] leading-8 text-[#6b7569]">
        {featuredArticle.excerpt}
      </p>
      <a
        href={`#article-${featuredArticle.id}`}
        class="mt-8 inline-flex rounded-[12px] bg-[#5d8765] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#4f7557]"
      >
        Lire l'article
      </a>
    </section>

    <section class="mt-12">
      <div class="mb-6">
        <h2 class="text-[2rem] font-semibold tracking-[-0.03em] text-[#314033] sm:text-[2.45rem]">
          Reperes depuis votre base
        </h2>
        <p class="mt-3 max-w-[760px] text-[15px] leading-7 text-[#6b7569]">
          Cette page reste raccordee a vos donnees actuelles: aliments, recettes et articles deja presents dans PocketBase.
        </p>
      </div>

      <div class="grid gap-4 lg:grid-cols-3">
        {quickStats.map((stat) => (
          <article class="rounded-[20px] border border-[#e4ddcf] bg-white p-6 shadow-[0_18px_36px_rgba(76,82,58,0.05)]">
            <div class="text-sm font-medium text-[#5d8765]">{stat.title}</div>
            <div class="mt-3 text-[1.55rem] font-semibold tracking-[-0.03em] text-[#314033]">{stat.value}</div>
            <p class="mt-3 text-[14px] leading-7 text-[#6b7569]">{stat.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-14 space-y-8">
      <div>
        <h2 class="text-[2rem] font-semibold tracking-[-0.03em] text-[#314033] sm:text-[2.45rem]">
          Guides detailles
        </h2>
        <p class="mt-3 max-w-[780px] text-[15px] leading-7 text-[#6b7569]">
          Des reperes simples, concrets et faciles a relire pour passer de la theorie a la pratique.
        </p>
      </div>

      {detailedArticles.map((article) => (
        <section
          id={`article-${article.id}`}
          data-advice-section
          data-category={article.categoryKey}
          class="rounded-[24px] border border-[#e4ddcf] bg-white p-6 shadow-[0_18px_36px_rgba(76,82,58,0.05)] sm:p-8"
        >
          <div class="flex flex-col gap-4 border-b border-[#ece7db] pb-6 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <div class="inline-flex rounded-full bg-[#eef2eb] px-3 py-1 text-[12px] font-medium text-[#556a59]">
                {article.categoryLabel}
              </div>
              <h3 class="mt-4 text-[2rem] font-semibold tracking-[-0.04em] text-[#314033]">
                {article.title}
              </h3>
            </div>
            <div class="text-sm text-[#788176]">{article.readTime} min de lecture</div>
          </div>

          <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
            <div class="space-y-4 text-[15px] leading-8 text-[#556151]">
              {article.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>

            <aside class="rounded-[20px] border border-[#e8e2d7] bg-[#f7f3ec] p-5">
              <h4 class="text-[18px] font-semibold tracking-[-0.03em] text-[#314033]">A retenir</h4>
              <ul class="mt-4 space-y-3 text-[14px] leading-7 text-[#6b7569]">
                {article.takeaways.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </aside>
          </div>
        </section>
      ))}
    </section>
  </main>

  <script is:inline>
    const filterButtons = Array.from(document.querySelectorAll('[data-advice-filter]'));
    const adviceCards = Array.from(document.querySelectorAll('[data-advice-card]'));
    const adviceSections = Array.from(document.querySelectorAll('[data-advice-section]'));
    const emptyState = document.querySelector('#advice-empty');

    const setActiveFilterButton = (selectedFilter) => {
      filterButtons.forEach((button) => {
        const isActive = button.dataset.adviceFilter === selectedFilter;
        button.className = isActive
          ? 'rounded-full border border-[#d9ddcf] bg-[#eef2eb] px-4 py-2 text-sm font-medium text-[#314033] transition'
          : 'rounded-full border border-[#ece6db] bg-[#f5f1ea] px-4 py-2 text-sm font-medium text-[#536151] transition hover:border-[#d9ddcf] hover:bg-[#eef2eb]';
      });
    };

    const applyAdviceFilter = (selectedFilter) => {
      let visibleCards = 0;

      adviceCards.forEach((card) => {
        const visible = selectedFilter === 'all' || card.dataset.category === selectedFilter;
        card.classList.toggle('hidden', !visible);
        if (visible) visibleCards += 1;
      });

      adviceSections.forEach((section) => {
        const sectionId = section.getAttribute('id') || '';
        const isFeatured = sectionId === 'article-regles-or-equilibre';
        const visible = isFeatured || selectedFilter === 'all' || section.dataset.category === selectedFilter;
        section.classList.toggle('hidden', !visible);
      });

      emptyState?.classList.toggle('hidden', visibleCards > 0);
      setActiveFilterButton(selectedFilter);
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        applyAdviceFilter(button.dataset.adviceFilter || 'all');
      });
    });
  </script>
</Layout>
